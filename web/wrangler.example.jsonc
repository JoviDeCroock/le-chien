{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-chien",
  "main": "./server/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart",
  },
  "vars": {
    "APP_URL": "http://localhost:5173",
    "BETTER_AUTH_URL": "http://localhost:5173/api/auth",
    "LOCAL": "true",
    "CF_ACCOUNT_ID": "replace-with-cloudflare-account-id",
    "CF_AI_GATEWAY_ID": "replace-with-ai-gateway-id",
    "POLAR_PRO_PRODUCT_ID": "replace-with-polar-product-id",
  },
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "ai": {
    "binding": "AI",
  },
  "browser": {
    "binding": "BROWSER",
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_AGENT", "class_name": "ChatAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chien-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations",
    },
  ],
}
