{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-chien",
  "main": "./server/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "vars": {
    "APP_URL": "http://localhost:5173",
    "BETTER_AUTH_URL": "http://localhost:5173/api/auth",
    "LOCAL": "true",
    "CF_ACCOUNT_ID": "replace-with-cloudflare-account-id",
    "CF_AI_GATEWAY_ID": "replace-with-ai-gateway-id",
    // Billing is opt-in. Leave BILLING_ENABLED as "false" (or omit it) to run
    // without Polar — every user becomes Pro with no rate limits. Flip to
    // "true" and set POLAR_PRO_PRODUCT_ID to enable billing.
    "BILLING_ENABLED": "false",
    // "POLAR_PRO_PRODUCT_ID": "replace-with-polar-product-id",
  },
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "ai": {
    "binding": "AI",
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_AGENT", "class_name": "ChatAgent" },
      { "name": "ARTIFACT_SESSION", "class_name": "ArtifactSession" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["ArtifactSession"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chien-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations",
    },
  ],
}
