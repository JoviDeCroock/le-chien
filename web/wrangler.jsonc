{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-chien",
  "main": "./server/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart",
  },
  "vars": {
    "APP_URL": "https://chien.resynapse.dev",
    "BETTER_AUTH_URL": "https://chien.resynapse.dev/api/auth",
    "LOCAL": "false",
    "CF_ACCOUNT_ID": "c8a74ade336909a754b36a7379edca30",
    "CF_AI_GATEWAY_ID": "chien-gateway",
    "POLAR_PRO_PRODUCT_ID": "ab6169f5-b277-4625-aaae-5af9277a2ab2",
  },
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "ai": {
    "binding": "AI",
  },
  "browser": {
    "binding": "BROWSER",
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_AGENT", "class_name": "ChatAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chien-db",
      "database_id": "4d023a5c-8473-43a0-9ae4-fcc2a8a3d070",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
    },
  ],
}
