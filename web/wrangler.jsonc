{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-chien",
  "main": "./server/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat", "unsafe-eval"],
  "placement": {
    "mode": "smart",
  },
  "vars": {
    "APP_URL": "https://app.example.com",
    "LOCAL": "false",
    "CF_ACCOUNT_ID": "c8a74ade336909a754b36a7379edca30",
    "CF_AI_GATEWAY_ID": "chien-gateway",
    // OPENAI_API_KEY is set via `wrangler secret put`
  },
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_AGENT", "class_name": "ChatAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations",
    },
  ],
}
