{
  "private": true,
  "scripts": {
    "dev": "cd web && npm run dev",
    "prepare": "node ./scripts/install-git-hooks.mjs",
    "lint": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check ."
  },
  "devDependencies": {
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yml,yaml,html}": "oxfmt --write --no-error-on-unmatched-pattern"
  }
}
