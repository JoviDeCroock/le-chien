{
  "name": "le-chien",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoviDeCroock/le-chien.git"
  },
  "scripts": {
    "dev": "pnpm --dir web dev",
    "prepare": "node ./scripts/install-git-hooks.mjs",
    "lint": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check ."
  },
  "devDependencies": {
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yml,yaml,html}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^1.19.14",
      "defu": "^6.1.7",
      "dompurify": "^3.4.1",
      "esbuild": "^0.25.12",
      "lodash": "^4.18.1",
      "picomatch": "^4.0.4",
      "postcss": "^8.5.10",
      "protobufjs": "^7.5.5",
      "rollup": "^4.60.2"
    }
  }
}
